/* pages/admin/feedback/feedback.wxss
 * 复用 mine/feedback 的类名与视觉，仅补充管理页必要的两个小类
 */

/* ================= 页面 ================= */
.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #F6F9F7;
}

/* ================= 反馈项 ================= */
.fb-item {
  position: relative;
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(47, 82, 61, 0.045);
}

.fb-content {
  color: #2B4738;
  font-size: 29rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.fb-time {
  margin-top: 14rpx;
  color: #9BA79F;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ================= 回复区 ================= */
.fb-reply {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  border-left: 6rpx solid #82B69A;
  background: #F3F8F5;
}

.reply-label {
  margin-bottom: 8rpx;
  color: #567560;
  font-size: 24rpx;
  font-weight: 600;
}

.fb-reply > view:not(.reply-label):not(.fb-time) {
  color: #2B4738;
  font-size: 27rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

/* ================= 操作区（与用户页一致） ================= */
.fb-actions {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: 18rpx;
  box-sizing: border-box;
}

.fb-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 calc((100% - 16rpx) / 2);
  min-width: 0;
  max-width: calc((100% - 16rpx) / 2);
  height: 60rpx;
  padding: 0;
  border-radius: 30rpx;
  font-size: 26rpx;
  line-height: 1;
  box-sizing: border-box;
  white-space: nowrap;
  margin: 0;
}

.fb-btn--cancel {
  color: #5C7A68 !important;
  background: #FFFFFF !important;
  border: 1rpx solid #CFE3D7 !important;
}
.fb-btn--cancel:active {
  background: #F1F7F3 !important;
}

.fb-btn--primary {
  color: #FFFFFF !important;
  background: #70AD91 !important;
  border: 1rpx solid #70AD91 !important;
  box-shadow: 0 6rpx 16rpx rgba(86, 151, 116, 0.22);
}
.fb-btn--primary:active {
  background: #5C9A7E !important;
  border-color: #5C9A7E !important;
}

/* 单按钮靠右（管理页"回复"按钮） */
.fb-actions--single {
  justify-content: flex-end;
}
.fb-actions--single .fb-btn {
  flex: 0 0 auto;
  width: 160rpx;
  max-width: 160rpx;
}

/* ================= 编辑/回复输入区（与用户页一致） ================= */
.fb-edit {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EEF3EF;
}

.fb-edit .van-cell {
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #F6F9F7;
}
.fb-edit .van-cell::after {
  border: none;
}
.fb-edit .van-field__control {
  color: #2B4738;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ================= 加载/结束 ================= */
.loading-tip,
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  color: #9BA99F;
  font-size: 22rpx;
}

/* ================= 管理页仅有的两个补充类 ================= */

/* 已回复徽标：沿用绿灰体系，轻量 */
.replied-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  background: #E8F2EC;
  color: #567560;
  font-size: 20rpx;
  line-height: 1.8;
  vertical-align: middle;
}

/* 无权限提示：与 fb-item 同卡片语言，不引入新风格 */
.no-perm {
  margin-top: 60rpx;
  padding: 40rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(47, 82, 61, 0.045);
  text-align: center;
}

.no-perm .title {
  color: #2B4738;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.5;
}

.no-perm .desc {
  margin-top: 12rpx;
  color: #9BA79F;
  font-size: 23rpx;
  line-height: 1.6;
}