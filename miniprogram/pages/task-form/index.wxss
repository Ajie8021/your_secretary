
.form-page {
  min-height: 100vh;
  padding: 34rpx 28rpx 54rpx;
  box-sizing: border-box;
  background: #F3F7F4;
  color: #294638;
}

/* 页面标题 */
.form-header {
  margin-bottom: 30rpx;
  padding: 6rpx 2rpx;
}

.form-eyebrow {
  margin-bottom: 8rpx;
  color: #83A491;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.form-title {
  color: #294638;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.5;
}

.form-subtitle {
  margin-top: 8rpx;
  color: #829188;
  font-size: 25rpx;
  line-height: 1.7;
}

/* 卡片 */
.form-card {
  margin-bottom: 24rpx;
  padding: 30rpx 26rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(47, 82, 61, 0.045);
}

.section-heading {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-mark {
  width: 8rpx;
  height: 32rpx;
  margin-right: 14rpx;
  border-radius: 8rpx;
}

.green-mark {
  background: #79B293;
}

.orange-mark {
  background: #D9AD68;
}

.purple-mark {
  background: #A393C8;
}

.section-title {
  color: #344D3F;
  font-size: 30rpx;
  font-weight: 600;
}

.section-desc {
  margin-top: -14rpx;
  margin-bottom: 22rpx;
  color: #8B9A90;
  font-size: 23rpx;
  line-height: 1.6;
}

/* 输入字段 */
.field {
  margin-bottom: 30rpx;
}

.last-field {
  margin-bottom: 0;
}

.label {
  margin-bottom: 14rpx;
  color: #405448;
  font-size: 27rpx;
  font-weight: 600;
}

.required {
  color: #D78273;
}

.input {
  width: 100%;
  min-height: 82rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 1rpx solid #E9F0EA;
  border-radius: 16rpx;
  background: #F6F9F6;
  color: #34483B;
  font-size: 27rpx;
}

.input-placeholder {
  color: #A2AEA5;
  font-size: 25rpx;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border: 1rpx solid #E9F0EA;
  border-radius: 16rpx;
  background: #F6F9F6;
  color: #34483B;
  font-size: 27rpx;
  line-height: 1.8;
}

.field-hint {
  margin-top: 10rpx;
  color: #9AA79E;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 重要程度选项 */
.level-options {
  display: block;
}

.level-option {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid #EDF1ED;
  border-radius: 18rpx;
  background: #FAFBFA;
}

.level-option:last-child {
  margin-bottom: 0;
}

.level-selected {
  border-color: #A7CBB3;
  background: #F0F7F1;
}

.level-urgent {
  border-color: #E6CC9D;
  background: #FFFAEF;
}

.level-important {
  border-color: #B8CBE7;
  background: #F3F7FD;
}

.level-critical {
  border-color: #E3BDB6;
  background: #FFF5F2;
}

.level-radio {
  flex-shrink: 0;
  transform: scale(0.9);
}

.level-option-text {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

.level-option-title {
  color: #405448;
  font-size: 27rpx;
  font-weight: 600;
}

.level-option-desc {
  margin-top: 6rpx;
  color: #94A198;
  font-size: 22rpx;
}

/* 日期和时间 */
.time-field {
  padding: 2rpx 0;
}

.time-field-heading {
  display: flex;
  align-items: center;
}

.time-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 62rpx;
  height: 62rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
}

.ddl-icon {
  color: #4F8A6A;
  background: #E8F3EB;
}

.remind-icon {
  color: #8978B5;
  background: #F0EDFA;
}

.time-field-info {
  flex: 1;
  min-width: 0;
}

.time-field-info .label {
  margin-bottom: 0;
}

.time-field-info .field-hint {
  margin-top: 6rpx;
}

.clear-text {
  flex-shrink: 0;
  padding: 10rpx 4rpx 10rpx 16rpx;
  color: #8EAA98;
  font-size: 23rpx;
}

.picker-row {
  display: flex;
  margin-top: 22rpx;
}

.picker-row picker {
  flex: 1;
  min-width: 0;
}

.picker-row picker:first-child {
  margin-right: 12rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 20rpx 14rpx;
  border: 1rpx solid #EAF0EB;
  border-radius: 16rpx;
  background: #F7F9F7;
}

.picker-label {
  flex-shrink: 0;
  margin-right: 10rpx;
  color: #94A197;
  font-size: 21rpx;
}

.picker-text {
  flex: 1;
  min-width: 0;
  color: #405448;
  font-size: 23rpx;
  text-align: center;
  word-break: break-all;
}

.picker-arrow {
  flex-shrink: 0;
  margin-left: 6rpx;
  color: #90A697;
  font-size: 32rpx;
}

.section-divider {
  height: 1rpx;
  margin: 30rpx 0;
  background: #EDF1ED;
}

/* 页面底部 */
.form-footer {
  margin-top: 32rpx;
}

.footer-tip {
  margin-bottom: 18rpx;
  color: #91A096;
  font-size: 22rpx;
  text-align: center;
}

.submit-button {
  width: 100%;
  margin: 0;
  border-radius: 20rpx;
  color: #FFFFFF;
  background: #70AD91;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 2.8;
  box-shadow: 0 10rpx 22rpx rgba(86, 151, 116, 0.16);
}

.submit-button[disabled] {
  color: #FFFFFF;
  background: #A8C8B4;
}

.submit-button::after {
  border: none;
}
