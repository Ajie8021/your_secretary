.form-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f6f7fb;
  box-sizing: border-box;
}

.form-card {
  background: #fff;
  padding: 28rpx;
  border-radius: 16rpx;
}

.field {
  margin-bottom: 32rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.input {
  min-height: 76rpx;
  padding: 0 20rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  margin: 16rpx 0;
  font-size: 26rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.picker-value {
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 24rpx;
}

.clear-text {
  color: #3478f6;
  font-size: 24rpx;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.submit-button {
  margin-top: 28rpx;
  color: #fff;
  background: #3478f6;
  border-radius: 12rpx;
}