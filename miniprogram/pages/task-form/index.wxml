
<view class="form-page">
  <!-- 页面说明 -->
  <view class="form-header">
    <view class="form-eyebrow">TASK PLANNER</view>
    <view class="form-title">
      {{isEdit ? '编辑任务' : '创建任务'}}
    </view>
    <view class="form-subtitle">
      {{isEdit ? '调整安排，让计划更合理' : '记录下来，让重要的事情不再遗忘'}}
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="form-card">
    <view class="section-heading">
      <view class="section-mark green-mark"></view>
      <view class="section-title">基本信息</view>
    </view>

    <view class="field">
      <view class="label">任务名称</view>
      <input
        class="input"
        placeholder="给任务起个名字"
        placeholder-class="input-placeholder"
        value="{{name}}"
        maxlength="100"
        bindinput="onNameInput"
      />
    </view>

    <view class="field">
      <view class="label">任务类型</view>
      <input
        class="input"
        placeholder="例如：学习、生活、工作"
        placeholder-class="input-placeholder"
        value="{{type}}"
        bindinput="onTypeInput"
      />
    </view>

    <view class="field last-field">
      <view class="label">任务描述</view>
      <textarea
        class="textarea"
        placeholder="写下任务目标、具体步骤或其他备注..."
        placeholder-class="input-placeholder"
        value="{{content}}"
        maxlength="3000"
        auto-height
        bindinput="onContentInput"
      />
      <view class="field-hint">可填写任务细节，方便之后查看</view>
    </view>
  </view>

  <!-- 重要程度 -->
  <view class="form-card">
    <view class="section-heading">
      <view class="section-mark orange-mark"></view>
      <view class="section-title">重要程度</view>
    </view>

    <view class="section-desc">根据任务紧急程度选择合适的等级</view>

    <radio-group class="level-options" bindchange="onLevelChange">
      <label class="level-option {{level === 1 ? 'level-selected level-normal' : ''}}">
        <radio class="level-radio" value="1" checked="{{level === 1}}" color="#70AD91" />
        <view class="level-option-text">
          <view class="level-option-title">一般</view>
          <view class="level-option-desc">按计划完成</view>
        </view>
      </label>

      <label class="level-option {{level === 2 ? 'level-selected level-urgent' : ''}}">
        <radio class="level-radio" value="2" checked="{{level === 2}}" color="#D5A24F" />
        <view class="level-option-text">
          <view class="level-option-title">紧急</view>
          <view class="level-option-desc">需要尽快处理</view>
        </view>
      </label>

      <label class="level-option {{level === 3 ? 'level-selected level-important' : ''}}">
        <radio class="level-radio" value="3" checked="{{level === 3}}" color="#7D9DD0" />
        <view class="level-option-text">
          <view class="level-option-title">重要</view>
          <view class="level-option-desc">优先安排时间</view>
        </view>
      </label>

      <label class="level-option {{level === 4 ? 'level-selected level-critical' : ''}}">
        <radio class="level-radio" value="4" checked="{{level === 4}}" color="#CB8D82" />
        <view class="level-option-text">
          <view class="level-option-title">重要且紧急</view>
          <view class="level-option-desc">优先立即处理</view>
        </view>
      </label>
    </radio-group>
  </view>

  <!-- 时间安排 -->
  <view class="form-card">
    <view class="section-heading">
      <view class="section-mark purple-mark"></view>
      <view class="section-title">时间安排</view>
    </view>

    <!-- 截止时间 -->
    <view class="time-field">
      <view class="time-field-heading">
        <view class="time-icon ddl-icon">时</view>
        <view class="time-field-info">
          <view class="label">截止时间</view>
          <view class="field-hint">希望在什么时间前完成？</view>
        </view>
        <text class="clear-text" bindtap="clearDdl">清除</text>
      </view>

      <view class="picker-row">
        <picker
          mode="date"
          value="{{ddlDate}}"
          bindchange="onDdlDateChange"
        >
          <view class="picker-value">
            <text class="picker-label">日期</text>
            <text class="picker-text">{{ddlDate || '选择日期'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>

        <picker
          mode="time"
          value="{{ddlTime}}"
          bindchange="onDdlTimeChange"
        >
          <view class="picker-value">
            <text class="picker-label">时间</text>
            <text class="picker-text">{{ddlTime || '选择时间'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="section-divider"></view>

    <!-- 提醒时间 -->
    <view class="time-field">
      <view class="time-field-heading">
        <view class="time-icon remind-icon">铃</view>
        <view class="time-field-info">
          <view class="label">提醒时间</view>
          <view class="field-hint">在合适的时间提醒自己</view>
        </view>
        <text class="clear-text" bindtap="clearReminder">清除</text>
      </view>

      <view class="picker-row">
        <picker
          mode="date"
          value="{{remindDate}}"
          bindchange="onRemindDateChange"
        >
          <view class="picker-value">
            <text class="picker-label">日期</text>
            <text class="picker-text">{{remindDate || '选择日期'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>

        <picker
          mode="time"
          value="{{remindTime}}"
          bindchange="onRemindTimeChange"
        >
          <view class="picker-value">
            <text class="picker-label">时间</text>
            <text class="picker-text">{{remindTime || '选择时间'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="form-footer">
    <view class="footer-tip">确认信息无误后，即可保存任务</view>
    <button
      class="submit-button"
      loading="{{saving}}"
      disabled="{{saving}}"
      bindtap="submitTask"
    >
      {{saving ? '正在保存...' : (isEdit ? '保存修改' : '创建任务')}}
    </button>
  </view>
</view>
