<view class="page">
  <!-- 加载 -->
  <view wx:if="{{loading}}" class="state-container">
    <text class="state-text">正在加载…</text>
  </view>

  <!-- 错误 -->
  <view wx:elif="{{errorMessage}}" class="state-container">
    <text class="state-text">{{errorMessage}}</text>
    <view class="retry-button" bindtap="goBack">返回任务列表</view>
  </view>

  <block wx:elif="{{task}}">
    <!-- 标题卡片 -->
    <view class="detail-item {{task.top ? 'is-top' : ''}}">
      <view class="detail-title">
        <text wx:if="{{task.top}}" class="top-tag">置顶</text>
        <text>{{task.name || '未命名任务'}}</text>
      </view>

      <view class="detail-tags">
        <text class="tag {{task.completed ? 'done-tag' : 'pending-tag'}}">{{task.completed ? '已完成' : '进行中'}}</text>
        <text class="tag level-tag">{{task.displayLevel}}</text>
        <text wx:if="{{task.displayType}}" class="tag type-tag">{{task.displayType}}</text>
      </view>

      <!-- 时间信息 -->
      <view class="info-row">
        <text class="info-label">截止时间</text>
        <text class="info-value">{{task.displayDdl}}</text>
      </view>
      <view wx:if="{{task.displayRemindAt}}" class="info-row">
        <text class="info-label">提醒时间</text>
        <text class="info-value">{{task.displayRemindAt}}</text>
      </view>
      <view wx:if="{{task.createTime}}" class="info-row">
        <text class="info-label">创建时间</text>
        <text class="info-value">{{task.displayCreateTime}}</text>
      </view>
    </view>

    <!-- 任务内容 -->
    <view wx:if="{{task.displayContent}}" class="detail-item">
      <view class="section-title">任务内容</view>
      <view class="content-text">{{task.displayContent}}</view>
    </view>

    <!-- 底部操作：编辑 + 删除 并排 -->
    <view class="bottom-actions">
      <view class="action-btn edit-button" bindtap="editTask">编辑任务</view>
      <view class="action-btn delete-button" bindtap="onDelete">删除任务</view>
    </view>
  </block>
</view>