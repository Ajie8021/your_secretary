/* pages/task-detail/index.wxss */

/* ================= 页面 ================= */
.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #F6F9F7;
}

/* ================= 信息卡片 ================= */
.detail-item {
  position: relative;
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(47, 82, 61, 0.045);
}

.detail-item.is-top {
  border-left: 6rpx solid #82B69A;
}

/* 标题 */
.detail-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  color: #2B4738;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.55;
  word-break: break-all;
}

.detail-title .top-tag {
  margin-right: 12rpx;
}

/* 标签 */
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.pending-tag {
  color: #9B783B;
  background: #FFF4DC;
}

.done-tag {
  color: #478260;
  background: #E5F3E8;
}

.type-tag {
  color: #4D876A;
  background: #E8F4EC;
}

.level-tag {
  color: #6E7F74;
  background: #F0F3F0;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.info-label {
  flex-shrink: 0;
  width: 150rpx;
  color: #9BA79F;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: #3A5245;
  word-break: break-all;
}

/* 小节标题 */
.section-title {
  margin-bottom: 16rpx;
  color: #2B4738;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

/* 正文 */
.content-text {
  color: #3A5245;
  font-size: 28rpx;
  line-height: 1.85;
  word-break: break-all;
  white-space: pre-wrap;
}

/* ================= 编辑按钮 ================= */
.edit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  height: 88rpx;
  border-radius: 44rpx;
  color: #FFFFFF;
  background: #70AD91;
  font-size: 29rpx;
  box-shadow: 0 10rpx 24rpx rgba(86, 151, 116, 0.28);
}

.edit-button:active {
  background: #5C9A7E;
}

/* ================= 加载/错误 ================= */
.state-container {
  display: flex;
  min-height: 420rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 50rpx 24rpx;
}

.state-text {
  color: #9BA79F;
  font-size: 26rpx;
  text-align: center;
  line-height: 1.8;
}

.retry-button {
  margin-top: 30rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  color: #FFFFFF;
  background: #70AD91;
  font-size: 25rpx;
}

.retry-button:active {
  background: #5C9A7E;
}

/* ================= 底部操作：等宽并排 ================= */
.bottom-actions {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

/* 两个按钮共用的尺寸与基础样式：
   高度、圆角、字号、字重、内边距一致，保证等大 */
.action-btn {
  flex: 1 1 0;              /* 各占一半，严格等宽 */
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;     /* 与 note-edit 保存按钮一致的圆角 */
  font-size: 29rpx;
  font-weight: 500;
  box-sizing: border-box;
}

/* 编辑：绿色主题，与 note-edit .save-button 观感一致 */
.edit-button {
  margin-right: 20rpx;
  color: #FFFFFF;
  background: #70AD91;
  box-shadow: 0 8rpx 18rpx rgba(86, 151, 116, 0.16);
}

.edit-button:active {
  background: #5C9A7E;
}

/* 删除：低饱和红，扁平色块、无阴影，按下变深，
   尺寸与编辑完全一致 */
.delete-button {
  color: #C97B7B;
  background: #FBEDED;
}

.delete-button:active {
  background: #F5DEDE;
}