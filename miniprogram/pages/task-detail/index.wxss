
/* =========================
   页面基础
   ========================= */

   page {
    background: #f3f7f4;
  }
  
  .page {
    min-height: 100vh;
    padding: 20rpx 30rpx 60rpx;
    box-sizing: border-box;
    color: #294338;
    background: #f3f7f4;
  }
  
  /* =========================
     顶部导航
     ========================= */
  
  .page-header {
    display: flex;
    height: 82rpx;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24rpx;
  }
  
  .back-button {
    display: flex;
    width: 140rpx;
    align-items: center;
    color: #60796b;
  }
  
  .back-arrow {
    margin-right: 10rpx;
    font-size: 48rpx;
    line-height: 1;
  }
  
  .back-text {
    font-size: 26rpx;
  }
  
  .page-title {
    color: #2c493a;
    font-size: 34rpx;
    font-weight: 600;
  }
  
  .header-placeholder {
    width: 140rpx;
  }
  
  /* =========================
     任务主卡片
     ========================= */
  
  .hero-card {
    position: relative;
    overflow: hidden;
    padding: 34rpx 32rpx 30rpx;
    margin-bottom: 24rpx;
    border-radius: 30rpx;
    color: #ffffff;
    background: linear-gradient(135deg, #72b69a 0%, #51977b 100%);
    box-shadow: 0 14rpx 32rpx rgba(73, 137, 106, 0.17);
  }
  
  .hero-decoration {
    position: absolute;
    border: 2rpx solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    pointer-events: none;
  }
  
  .hero-decoration-one {
    top: -100rpx;
    right: -70rpx;
    width: 300rpx;
    height: 300rpx;
  }
  
  .hero-decoration-two {
    top: -45rpx;
    right: -15rpx;
    width: 190rpx;
    height: 190rpx;
  }
  
  .hero-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .hero-label {
    display: flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.83);
    font-size: 20rpx;
    letter-spacing: 3rpx;
  }
  
  .hero-label-dot {
    width: 12rpx;
    height: 12rpx;
    margin-right: 12rpx;
    border-radius: 50%;
    background: #d7f4a5;
    box-shadow: 0 0 12rpx rgba(215, 244, 165, 0.45);
  }
  
  .top-badge {
    display: flex;
    align-items: center;
    padding: 8rpx 14rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.24);
    border-radius: 24rpx;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.14);
    font-size: 21rpx;
  }
  
  .top-badge-star {
    margin-right: 6rpx;
    color: #ffedb2;
  }
  
  .hero-title {
    position: relative;
    z-index: 1;
    margin-top: 30rpx;
    color: #ffffff;
    font-size: 42rpx;
    font-weight: 600;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  
  .hero-description {
    position: relative;
    z-index: 1;
    margin-top: 10rpx;
    color: rgba(255, 255, 255, 0.82);
    font-size: 24rpx;
    line-height: 1.8;
  }
  
  .hero-line {
    height: 1rpx;
    margin: 28rpx 0 24rpx;
    background: rgba(255, 255, 255, 0.22);
  }
  
  .hero-bottom {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .status-pill {
    display: flex;
    align-items: center;
    padding: 10rpx 18rpx;
    border-radius: 30rpx;
    font-size: 23rpx;
  }
  
  .status-completed {
    color: #e4f8e8;
    background: rgba(28, 89, 61, 0.27);
  }
  
  .status-pending {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.17);
  }
  
  .status-dot {
    width: 12rpx;
    height: 12rpx;
    margin-right: 10rpx;
    border-radius: 50%;
    background: #d7f4a5;
  }
  
  .status-completed .status-dot {
    background: #b7f0c4;
  }
  
  .hero-priority {
    display: flex;
    align-items: center;
  }
  
  .priority-label {
    margin-right: 12rpx;
    color: rgba(255, 255, 255, 0.75);
    font-size: 23rpx;
  }
  
  .priority-value {
    min-width: 34rpx;
    padding: 6rpx 12rpx;
    border-radius: 10rpx;
    color: #4c7c62;
    background: #e5f4d5;
    font-size: 24rpx;
    font-weight: 600;
    text-align: center;
  }
  
  .hero-watermark {
    position: absolute;
    right: 24rpx;
    bottom: 50rpx;
    color: rgba(255, 255, 255, 0.055);
    font-size: 180rpx;
    font-weight: 700;
    line-height: 1;
    pointer-events: none;
  }
  
  /* =========================
     任务分类条
     ========================= */
  
  .category-row {
    display: flex;
    align-items: center;
    padding: 22rpx 24rpx;
    margin-bottom: 24rpx;
    border: 1rpx solid #e8f0e9;
    border-radius: 22rpx;
    background: #ffffff;
    box-shadow: 0 6rpx 20rpx rgba(47, 80, 59, 0.035);
  }
  
  .category-icon {
    display: flex;
    width: 72rpx;
    height: 72rpx;
    align-items: center;
    justify-content: center;
    margin-right: 20rpx;
    border-radius: 22rpx;
    color: #4c9474;
    background: #e7f4eb;
    font-size: 38rpx;
  }
  
  .category-info {
    display: flex;
    flex: 1;
    flex-direction: column;
  }
  
  .category-caption {
    margin-bottom: 8rpx;
    color: #96a69b;
    font-size: 22rpx;
  }
  
  .category-name {
    color: #354f40;
    font-size: 28rpx;
    font-weight: 600;
  }
  
  .category-arrow {
    padding-left: 12rpx;
    color: #b3c2b7;
    font-size: 40rpx;
  }
  
  /* =========================
     通用信息卡片
     ========================= */
  
  .section-card {
    padding: 30rpx 28rpx;
    margin-bottom: 24rpx;
    border: 1rpx solid #eaf0eb;
    border-radius: 26rpx;
    background: #ffffff;
    box-shadow: 0 8rpx 24rpx rgba(47, 80, 59, 0.04);
  }
  
  .section-heading {
    display: flex;
    align-items: center;
    margin-bottom: 32rpx;
  }
  
  .section-icon {
    display: flex;
    width: 70rpx;
    height: 70rpx;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 18rpx;
    border-radius: 22rpx;
    font-size: 42rpx;
    font-weight: 500;
  }
  
  .time-section-icon {
    color: #4b9675;
    background: #e9f5ed;
  }
  
  .content-section-icon {
    color: #718bbd;
    background: #edf1fc;
  }
  
  .section-heading-text {
    display: flex;
    flex: 1;
    flex-direction: column;
  }
  
  .section-title {
    margin-bottom: 8rpx;
    color: #304a3a;
    font-size: 31rpx;
    font-weight: 600;
  }
  
  .section-subtitle {
    color: #9aa79e;
    font-size: 21rpx;
    line-height: 1.6;
  }
  
  /* =========================
     时间轴
     ========================= */
  
  .timeline {
    padding-left: 2rpx;
  }
  
  .timeline-item {
    display: flex;
    min-height: 148rpx;
  }
  
  .timeline-last {
    min-height: 95rpx;
  }
  
  .timeline-rail {
    display: flex;
    width: 58rpx;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    margin-right: 18rpx;
  }
  
  .timeline-node {
    display: flex;
    width: 48rpx;
    height: 48rpx;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 24rpx;
    font-weight: 600;
  }
  
  .deadline-node {
    color: #c27c62;
    background: #fff0e9;
    border: 2rpx solid #f9d8c9;
  }
  
  .reminder-node {
    color: #8b7bb7;
    background: #f2edfc;
    border: 2rpx solid #e5dcf8;
  }
  
  .created-node {
    color: #528e6d;
    background: #e9f5eb;
    border: 2rpx solid #d7ebdb;
  }
  
  .timeline-line {
    width: 2rpx;
    flex: 1;
    min-height: 50rpx;
    margin: 8rpx 0;
    background: #e5eee7;
  }
  
  .timeline-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 2rpx 0 28rpx;
  }
  
  .timeline-label {
    margin-bottom: 10rpx;
    color: #8c9a90;
    font-size: 23rpx;
  }
  
  .timeline-date {
    color: #344d3d;
    font-size: 29rpx;
    font-weight: 600;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  
  .timeline-note {
    margin-top: 8rpx;
    color: #a0aca3;
    font-size: 21rpx;
    line-height: 1.6;
  }
  
  /* =========================
     任务内容面板
     ========================= */
  
  .description-card {
    padding-bottom: 24rpx;
  }
  
  .description-card .section-heading {
    margin-bottom: 26rpx;
  }
  
  .description-paper {
    position: relative;
    padding: 26rpx 24rpx 26rpx 30rpx;
    overflow: hidden;
    border-radius: 16rpx;
    background: #f7faf7;
  }
  
  .description-accent {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 6rpx;
    border-radius: 6rpx;
    background: #8bc3a2;
  }
  
  .description-text {
    color: #52665a;
    font-size: 28rpx;
    line-height: 2;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  
  .description-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-top: 22rpx;
    color: #a2b1a5;
    font-size: 21rpx;
  }
  
  .description-footer-icon {
    margin-right: 8rpx;
    color: #81b69a;
    font-size: 30rpx;
  }
  
  /* =========================
     底部编辑区域
     ========================= */
  
  .bottom-area {
    padding-top: 8rpx;
  }
  
  .edit-button {
    display: flex;
    height: 94rpx;
    align-items: center;
    justify-content: center;
    border-radius: 22rpx;
    color: #ffffff;
    background: linear-gradient(135deg, #79b99b 0%, #5b9d7e 100%);
    box-shadow: 0 10rpx 22rpx rgba(79, 143, 109, 0.18);
    font-size: 30rpx;
    font-weight: 500;
    line-height: 94rpx;
  }
  
  .edit-button::after {
    border: none;
  }
  
  .edit-button-icon {
    margin-right: 14rpx;
    font-size: 34rpx;
  }
  
  .bottom-tip {
    display: block;
    margin-top: 22rpx;
    color: #a2afa5;
    font-size: 21rpx;
    text-align: center;
  }
  
  /* =========================
     加载与错误状态
     ========================= */
  
  .state-container {
    display: flex;
    min-height: 420rpx;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 50rpx 24rpx;
  }
  
  .loading-dot {
    width: 42rpx;
    height: 42rpx;
    border: 5rpx solid #dcece1;
    border-top-color: #6eae8c;
    border-radius: 50%;
  }
  
  .state-text {
    margin-top: 24rpx;
    color: #8b9b90;
    font-size: 26rpx;
  }
  
  .error-icon {
    display: flex;
    width: 76rpx;
    height: 76rpx;
    align-items: center;
    justify-content: center;
    margin-bottom: 22rpx;
    border-radius: 50%;
    color: #bd7469;
    background: #fbece8;
    font-size: 40rpx;
  }
  
  .error-title {
    margin-bottom: 12rpx;
    color: #4a5e51;
    font-size: 31rpx;
    font-weight: 600;
  }
  
  .error-text {
    color: #a17f79;
    font-size: 25rpx;
    text-align: center;
    line-height: 1.8;
  }
  
  .retry-button {
    margin-top: 30rpx;
    padding: 0 32rpx;
    border-radius: 16rpx;
    color: #ffffff;
    background: #70ad91;
    font-size: 26rpx;
  }
  
  .retry-button::after {
    border: none;
  }
  