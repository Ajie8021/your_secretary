.container {
  padding: 40rpx;
}

.title {
  margin-bottom: 12rpx;
  font-size: 44rpx;
  font-weight: bold;
}

.subtitle {
  margin-bottom: 36rpx;
  color: #777777;
  font-size: 26rpx;
}

.status {
  margin: 24rpx 0;
  color: #666666;
}

.panel,
.error-panel {
  margin: 24rpx 0;
  padding: 28rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.success {
  margin-bottom: 24rpx;
  color: #16803d;
  font-weight: bold;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
  word-break: break-all;
}

.label {
  color: #777777;
  font-size: 24rpx;
}

.error-panel {
  color: #c62828;
  word-break: break-all;
}