.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
  background: #F6F9F7;
}

.brand {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  color: #2B4738;
  font-size: 48rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 16rpx;
  color: #9BA79F;
  font-size: 26rpx;
}

.login-btn {
  height: 88rpx;
  border-radius: 44rpx;
  color: #FFFFFF !important;
  background: #70AD91 !important;
  border: none !important;
  font-size: 30rpx;
}

.error {
  margin-top: 20rpx;
  color: #C4564A;
  font-size: 24rpx;
  text-align: center;
}

.skip {
  margin-top: 32rpx;
  color: #9BA79F;
  font-size: 26rpx;
  text-align: center;
}