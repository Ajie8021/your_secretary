<view class="login-page">
  <view class="brand">
    <view class="title">备忘秘书</view>
    <view class="subtitle">记录 DDL，按时提醒</view>
  </view>

  <view class="actions">
    <van-button
      custom-class="login-btn"
      block
      loading="{{loading}}"
      bindtap="onLogin"
    >微信登录</van-button>

    <view wx:if="{{errorMsg}}" class="error">{{errorMsg}}</view>
  </view>
</view>