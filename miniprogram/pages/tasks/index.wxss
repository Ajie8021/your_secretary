/* pages/task/index.wxss */

/* ================= 页面 ================= */
.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #F6F9F7;
}

/* ================= 顶部 ================= */
.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.header-info {
  flex: 1;
  min-width: 0;
}

.title {
  color: #2B4738;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.subtitle {
  margin-top: 8rpx;
  color: #9BA79F;
  font-size: 23rpx;
  line-height: 1.4;
}

.add-button {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  color: #FFFFFF;
  background: #70AD91;
  font-size: 25rpx;
  box-shadow: 0 8rpx 20rpx rgba(86, 151, 116, 0.22);
}

.add-button:active {
  background: #5C9A7E;
}

/* ================= 右滑容器 ================= */
.task-swipe {
  position: relative;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  /* overflow:hidden 会把超出容器高度的内容裁掉；
     这里保留是为了裁掉卡片右移时露出的部分，
     但由于不设固定高度，容器高度=卡片高度，不会被裁 */
  overflow: hidden;
}

/* 底层"完成/恢复"提示 */
.swipe-action {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  width: 160rpx;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}
.swipe-complete { background: #70AD91; }
.swipe-restore  { background: #C9A05B; }

/* ================= 任务卡片 ================= */
/* 注意：绝不能在这里写 height 或 min-height，
   卡片高度必须由内部标题/标签/内容/时间自然撑开 */
.task-item {
  position: relative;
  z-index: 1;
  padding: 28rpx 26rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(47, 82, 61, 0.045);
  transition: transform 0.15s ease;
}

.task-item.is-top {
  border-left: 6rpx solid #82B69A;
}

.task-item.is-completed {
  opacity: 0.7;
}

/* 标题 */
.task-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  color: #2B4738;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.55;
  word-break: break-all;
}

.task-title .top-tag {
  margin-right: 12rpx;
}

.completed {
  color: #9BA79F;
  text-decoration: line-through;
}

/* 标签 */
.task-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.pending-tag { color: #9B783B; background: #FFF4DC; }
.done-tag    { color: #478260; background: #E5F3E8; }
.type-tag    { color: #4D876A; background: #E8F4EC; }
.level-tag   { color: #6E7F74; background: #F0F3F0; }

/* 内容：一行 */
.task-content {
  display: block;
  margin-top: 16rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #718177;
  font-size: 25rpx;
  line-height: 1.6;
}

/* 截止时间 */
.task-ddl {
  margin-top: 16rpx;
  color: #9BA79F;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ================= 空状态 ================= */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 36rpx;
  padding: 70rpx 30rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(47, 82, 61, 0.045);
}

.empty-title {
  color: #2B4738;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.empty-desc {
  margin-top: 12rpx;
  color: #9BA79F;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.6;
}

.empty-add-button {
  margin-top: 30rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  color: #FFFFFF;
  background: #70AD91;
  font-size: 25rpx;
  box-shadow: 0 8rpx 20rpx rgba(86, 151, 116, 0.22);
}

.empty-add-button:active {
  background: #5C9A7E;
}

/* ================= 加载/结束 ================= */
.more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0;
  height: 72rpx;
  border-radius: 16rpx;
  color: #4F8568;
  background: #E5F0E8;
  font-size: 25rpx;
}

.more-button:active {
  background: #DCEBE2;
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  color: #9BA99F;
  font-size: 22rpx;
}