
.page {
  min-height: 100vh;
  padding: 36rpx 28rpx 48rpx;
  box-sizing: border-box;
  background: #F3F7F4;
  color: #294638;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.header-info {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  margin-bottom: 8rpx;
  color: #83A491;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.title {
  color: #294638;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.4;
}

.subtitle {
  margin-top: 8rpx;
  color: #809187;
  font-size: 25rpx;
}

.total-count {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  color: #4E896C;
  background: #E3F0E7;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.add-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 12rpx 0 0 16rpx;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 22rpx;
  background: #70AD91;
  color: #FFFFFF;
  font-size: 25rpx;
  box-shadow: 0 8rpx 18rpx rgba(86, 151, 116, 0.16);
}

.add-button::after,
.empty-add-button::after,
.detail-button::after,
.manage-button::after,
.more-button::after {
  border: none;
}

.add-icon {
  margin-right: 6rpx;
  font-size: 32rpx;
}

/* 提示横幅 */
.tip-banner {
  display: flex;
  align-items: center;
  margin-bottom: 26rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #E5F0E8;
}

.tip-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  color: #FFFFFF;
  background: #82B69A;
  font-size: 24rpx;
}

.tip-text {
  color: #557764;
  font-size: 23rpx;
  line-height: 1.6;
}

/* 任务卡片 */
.task-card {
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx 22rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(47, 82, 61, 0.045);
}

.task-main {
  min-width: 0;
}

.task-title-row {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
}

.task-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  margin: 2rpx 16rpx 0 0;
  border-radius: 14rpx;
  color: #4D8B6B;
  background: #E8F3EB;
  font-size: 32rpx;
  line-height: 1;
}

.symbol-done {
  color: #FFFFFF;
  background: #83B69A;
  font-size: 24rpx;
}

.task-title-wrap {
  flex: 1;
  min-width: 180rpx;
}

.task-title {
  color: #2B4738;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.55;
  word-break: break-all;
}

.completed {
  color: #9BA79F;
  text-decoration: line-through;
}

/* 标签外框统一负责尺寸和垂直居中 */
.tag {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;

  height: 40rpx;
  padding: 0 14rpx;

  font-size: 22rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.top-tag {
  color: #A57839;
  background: #FFF1D9;
}

.task-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.pending-tag {
  color: #9B783B;
  background: #FFF4DC;
}

.done-tag {
  color: #478260;
  background: #E5F3E8;
}

.type-tag {
  color: #4D876A;
  background: #E8F4EC;
}

.level-tag {
  color: #6E7F74;
  background: #F0F3F0;
}

/* 内容限制为一行 */
.task-content {
  display: block;
  margin-top: 18rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #718177;
  font-size: 25rpx;
  line-height: 1.6;
}

/* 截止时间 */
.task-ddl-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.calendar-icon {
  flex-shrink: 0;
  margin-right: 10rpx;
  color: #78A58B;
  font-size: 32rpx;
}

.task-ddl {
  flex: 1;
  min-width: 0;
  color: #7A8B80;
  font-size: 23rpx;
  line-height: 1.6;
  word-break: break-all;
}

/* 卡片底部 */
.task-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #EDF1ED;
}

.task-footer-tip {
  flex: 1;
  min-width: 180rpx;
  color: #A0ACA4;
  font-size: 21rpx;
}

.task-actions {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
}

.task-actions button {
  margin: 0 0 0 12rpx;
  padding: 0 22rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
}

.detail-button {
  color: #4E8768;
  background: #EAF4ED;
}

.manage-button {
  color: #FFFFFF;
  background: #78AD91;
}

/* 空状态 */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 36rpx;
  padding: 70rpx 30rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 34rpx;
  color: #6CA586;
  background: #E6F2E9;
  font-size: 52rpx;
}

.empty-title {
  margin-top: 26rpx;
  color: #385746;
  font-size: 31rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 12rpx;
  color: #8A9A8F;
  font-size: 24rpx;
  text-align: center;
}

.empty-add-button {
  margin-top: 30rpx;
  padding: 0 32rpx;
  border-radius: 18rpx;
  color: #FFFFFF;
  background: #78AD91;
  font-size: 25rpx;
}

/* 加载更多 */
.more-button {
  margin: 28rpx 0;
  border-radius: 18rpx;
  color: #4F8568;
  background: #E5F0E8;
  font-size: 26rpx;
}

.end-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  color: #9BA99F;
  font-size: 22rpx;
}

.end-line {
  width: 54rpx;
  height: 1rpx;
  margin: 0 16rpx;
  background: #DCE6DE;
}
