.page {
  padding: 28rpx;
  background: #f6f7fb;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  color: #888;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.add-button {
  margin: 0;
  background: #3478f6;
  color: #fff;
  font-size: 26rpx;
}

.task-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.task-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: 600;
  word-break: break-all;
}

.completed {
  color: #999;
  text-decoration: line-through;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.top-tag {
  color: #c66a18;
  background: #fff0dd;
}

.done-tag {
  color: #39845b;
  background: #e5f7eb;
}

.task-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  color: #666;
  font-size: 24rpx;
  margin-top: 18rpx;
}

.task-ddl {
  color: #666;
  font-size: 24rpx;
  margin-top: 14rpx;
  word-break: break-all;
}

.task-content {
  color: #555;
  font-size: 26rpx;
  margin-top: 14rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.task-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 22rpx;
}

.task-actions button {
  margin: 0;
}

.empty {
  text-align: center;
  padding: 100rpx 20rpx;
  color: #888;
}

.more-button {
  margin: 28rpx 0;
}

.end-tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 24rpx 0;
}