<view class="page">
  <view class="header">
    <view class="header-info">
      <view class="title">我的任务</view>
      <view class="subtitle">共 {{total}} 项任务</view>
    </view>
    <view class="add-button" bindtap="createTask">＋ 新建</view>
  </view>

  <view wx:if="{{tasks.length === 0 && !loading}}" class="empty-card">
    <view class="empty-title">暂时没有任务</view>
    <view class="empty-desc">给自己安排一件小事，从这里开始</view>
    <view class="empty-add-button" bindtap="createTask">＋ 创建第一项任务</view>
  </view>

  <view wx:for="{{tasks}}" wx:key="id" class="task-swipe">
    <view class="swipe-action {{item.completed ? 'swipe-restore' : 'swipe-complete'}}">
      {{item.completed ? '恢复' : '完成'}}
    </view>

    <view
      class="task-item {{item.top ? 'is-top' : ''}} {{item.completed ? 'is-completed' : ''}}"
      style="transform: translateX({{item._swipeX || 0}}px);"
      data-index="{{index}}"
      data-id="{{item.id}}"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchEnd"
      bindlongpress="onLongPress"
    >
      <view class="task-title">
        <text wx:if="{{item.top}}" class="top-tag">置顶</text>
        <text class="{{item.completed ? 'completed' : ''}}">{{item.name || '未命名任务'}}</text>
      </view>

      <view class="task-tags">
        <text class="tag {{item.completed ? 'done-tag' : 'pending-tag'}}">{{item.completed ? '已完成' : '进行中'}}</text>
        <text wx:if="{{item.type}}" class="tag type-tag">{{item.type}}</text>
        <text class="tag level-tag">{{item.level === 4 ? '重要且紧急' : item.level === 3 ? '重要' : item.level === 2 ? '紧急' : '一般'}}</text>
      </view>

      <view wx:if="{{item.content}}" class="task-content">{{item.content}}</view>

      <view class="task-ddl">截止时间：{{item.ddl || '未设置'}}</view>
    </view>
  </view>

  <view wx:if="{{hasMore}}" class="more-button" bindtap="loadMore">
    {{loading ? '加载中…' : '加载更多任务'}}
  </view>

  <view wx:if="{{!hasMore && tasks.length > 0}}" class="no-more">已显示全部任务</view>
</view>