/* pages/note-edit/note-edit.wxss */

/* 表单区块之间的间距由 van-field 自带，这里只处理图片区与保存按钮 */

/* ================= 图片区 ================= */
.imgs {
  display: flex;
  flex-wrap: wrap;
  margin: 28rpx 0 40rpx;
  padding: 0 4rpx;
}

.img-cell,
.img-add {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 18rpx;
  overflow: hidden;
}

.img-cell .img {
  width: 100%;
  height: 100%;
  background: #EDF3EE;
}

/* 删除角标 */
.img-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #FFFFFF;
  background: rgba(41, 70, 56, 0.62);
  font-size: 30rpx;
  line-height: 1;
}

/* 添加占位 */
.img-add {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #78A58B;
  background: #EAF3EC;
  border: 1rpx dashed #B6D2C0;
  font-size: 56rpx;
  font-weight: 300;
  box-sizing: border-box;
}

.img-add:active {
  background: #E0EDE4;
}

/* ================= 保存按钮 ================= */
/* 主题色保存按钮（覆盖 Vant 默认） */
.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 22rpx;
  color: #FFFFFF;
  background: #70AD91;
  font-size: 28rpx;
  box-shadow: 0 8rpx 18rpx rgba(86, 151, 116, 0.16);
}

.save-button:active {
  background: #5C9A7E;
}

/* 禁用态 */
.save-button.is-disabled {
  background: #B7CFC0;
  box-shadow: none;
}

/* 正文输入区：固定高度、内部可滚动 */
.content-field .van-field__control {
  min-height: 500rpx !important;
  max-height: 900rpx;
  overflow-y: auto;
}