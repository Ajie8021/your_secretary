/* pages/mine/feedback/feedback.wxss */

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #F6F9F7;
}

/* ================= 提交区 ================= */
.submit-box {
  margin-bottom: 28rpx;
  padding: 8rpx 8rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(47, 82, 61, 0.045);
}

.submit-box .van-cell {
  padding: 26rpx 22rpx;
  background: transparent;
}

.submit-box .van-cell::after {
  border: none;
}

.submit-box .van-field__control {
  color: #2B4738;
  font-size: 28rpx;
  line-height: 1.6;
}

.submit-box .van-field__control::placeholder {
  color: #B4C0B8;
}

/* 文本框加高：通过 custom-class 作用到 textarea 本体 */
.submit-textarea .van-field__control {
  min-height: 280rpx;   /* 约 6~7 行，可按需调 */
  height: 280rpx;
  padding: 4rpx 0;
  box-sizing: border-box;
}

/* 提交按钮居中容器 */
.submit-btn-wrap {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

/* 按钮本身：固定宽度、圆角、绿色 */
.submit-btn {
  width: 320rpx;
  height: 80rpx;
  border-radius: 40rpx;
  color: #FFFFFF;
  background: #70AD91;
  font-size: 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(86, 151, 116, 0.28);
}

.submit-btn:active {
  background: #5C9A7E;
}

/* ================= 反馈项 ================= */
.fb-item {
  position: relative;
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(47, 82, 61, 0.045);
}

.fb-content {
  color: #2B4738;
  font-size: 29rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.fb-time {
  margin-top: 14rpx;
  color: #9BA79F;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ================= 回复区 ================= */
.fb-reply {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  border-left: 6rpx solid #82B69A;
  background: #F3F8F5;
}

.reply-label {
  margin-bottom: 8rpx;
  color: #567560;
  font-size: 24rpx;
  font-weight: 600;
}

.fb-reply > view:not(.reply-label):not(.fb-time) {
  color: #2B4738;
  font-size: 27rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

/* ================= 操作区 ================= */
/* 同一行：nowrap；宽度严格限制在卡片内 */
.fb-actions {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: 18rpx;
  box-sizing: border-box;
}

/* ================= 按钮基础 ================= */
/* 收敛 Vant 默认尺寸；两按钮各占约一半，中间留间距 */
.fb-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 calc((100% - 16rpx) / 2);  /* 显式等分，扣掉中间间距 */
  min-width: 0;
  max-width: calc((100% - 16rpx) / 2);
  height: 60rpx;
  padding: 0;
  border-radius: 30rpx;
  font-size: 26rpx;
  line-height: 1;
  box-sizing: border-box;
  white-space: nowrap;
  margin: 0;
}

/* 取消：#CFE3D7 主色（描边款） */
.fb-btn--cancel {
  color: #5C7A68 !important;
  background: #FFFFFF !important;
  border: 1rpx solid #CFE3D7 !important;
}

.fb-btn--cancel:active {
  background: #F1F7F3 !important;
}

/* 修改 / 保存：#70AD91 主色（常态即绿，实心款） */
.fb-btn--primary {
  color: #FFFFFF !important;
  background: #70AD91 !important;
  border: 1rpx solid #70AD91 !important;
  box-shadow: 0 6rpx 16rpx rgba(86, 151, 116, 0.22);
}

.fb-btn--primary:active {
  background: #5C9A7E !important;
  border-color: #5C9A7E !important;
}

.fb-actions--single {
  justify-content: flex-end;
}
.fb-actions--single .fb-btn {
  flex: 0 0 auto;
  width: 160rpx;
  max-width: 160rpx;
}

/* ================= 编辑区 ================= */
.fb-edit {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EEF3EF;
}

.fb-edit .van-cell {
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #F6F9F7;
}

.fb-edit .van-cell::after {
  border: none;
}

.fb-edit .van-field__control {
  color: #2B4738;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ================= 加载/结束 ================= */
.loading-tip,
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  color: #9BA99F;
  font-size: 22rpx;
}