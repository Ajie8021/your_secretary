/* pages/mine/feedback/feedback.wxss */

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #F6F9F7;
}

/* ================= 提交区 ================= */
.submit-box {
  margin-bottom: 28rpx;
  padding: 8rpx 8rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(47, 82, 61, 0.045);
}

.submit-box .van-cell {
  padding: 26rpx 22rpx;
  background: transparent;
}

.submit-box .van-cell::after {
  border: none;
}

.submit-box .van-field__control {
  color: #2B4738;
  font-size: 28rpx;
  line-height: 1.6;
}

.submit-box .van-field__control::placeholder {
  color: #B4C0B8;
}

.submit-btn {
  margin: 16rpx 22rpx 0;
  height: 80rpx;
  border-radius: 40rpx;
  color: #FFFFFF;
  background: #70AD91;
  font-size: 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(86, 151, 116, 0.28);
}

.submit-btn:active {
  background: #5C9A7E;
}

/* ================= 反馈项 ================= */
.fb-item {
  position: relative;
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(47, 82, 61, 0.045);
}

.fb-content {
  color: #2B4738;
  font-size: 29rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.fb-time {
  margin-top: 14rpx;
  color: #9BA79F;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ================= 回复区 ================= */
.fb-reply {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  border-left: 6rpx solid #82B69A;
  background: #F3F8F5;
}

.reply-label {
  margin-bottom: 8rpx;
  color: #567560;
  font-size: 24rpx;
  font-weight: 600;
}

.fb-reply > view:not(.reply-label):not(.fb-time) {
  color: #2B4738;
  font-size: 27rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

/* ================= 操作区 ================= */
.fb-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.fb-actions .van-button {
  margin-left: 16rpx;
  border-radius: 32rpx;
}

/* ================= 编辑区 ================= */
.fb-edit {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EEF3EF;
}

.fb-edit .van-cell {
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #F6F9F7;
}

.fb-edit .van-cell::after {
  border: none;
}

.fb-edit .van-field__control {
  color: #2B4738;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ================= 加载/结束 ================= */
.loading-tip,
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  color: #9BA99F;
  font-size: 22rpx;
}